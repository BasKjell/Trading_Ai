{
  "name": "crisis_event_shadow",
  "family": "crisis_event",
  "market": "equity",
  "universe": ["SPY", "QQQ"],
  "indicators": [
    {"alias": "trend", "kind": "sma", "window": 50, "source": "close"},
    {"alias": "atr20", "kind": "atr", "window": 20, "source": "close"}
  ],
  "entry_all": [{"left": "close", "op": ">", "right": "trend"}],
  "exit_any": [{"left": "close", "op": "<", "right": "trend"}],
  "stop_atr_alias": "atr20",
  "stop_atr_multiple": 3.0,
  "rank_by": null,
  "max_positions": 1,
  "rebalance_every": 1,
  "data_requirements": ["crisis_events", "primary_evidence", "event_received_timestamp"],
  "rationale": "Crisis/event shadow research; no claim that crises can be predicted.",
  "version": "0.1-shadow"
}
