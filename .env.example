# Copy to .env and fill in locally. Never commit .env.

# Local-only Ollama research
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_DEEP_MODEL=qwen3-coder:30b
OLLAMA_SEARCH_ITERATIONS=3

# Application safety: offline research and simulated paper mode only
TRADING_MODE=paper
PAPER_TRADING_ONLY=true
LIVE_TRADING_ENABLED=false

# Optional point-in-time market-data provider
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=

# Optional crypto spot-data provider
CRYPTO_DATA_PROVIDER=
CRYPTO_DATA_API_KEY=
CRYPTO_DATA_API_SECRET=

# Optional licensed news/event provider
NEWS_DATA_PROVIDER=
NEWS_DATA_API_KEY=

# SEC requests use an identifying User-Agent, not an API key
SEC_USER_AGENT=

# Optional paper/sandbox broker integration; intentionally disabled
PAPER_BROKER_PROVIDER=
PAPER_BROKER_BASE_URL=
PAPER_BROKER_API_KEY=
PAPER_BROKER_API_SECRET=
PAPER_BROKER_ACCOUNT_ID=
